default_platform(:ios)

platform :ios do
  desc "Signieren (fastlane match), bauen und zu TestFlight laden"
  lane :beta do
    setup_ci # temporärer Keychain auf dem CI-Runner

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )

    # Verteil-Zertifikat + App-Store-Profil einmalig erzeugen und im Branch
    # match-certs (verschlüsselt) ablegen; danach bei jedem Lauf wiederverwenden.
    match(
      type: "appstore",
      app_identifier: "de.thomas-peterson.roster",
      api_key: api_key,
      git_url: ENV.fetch("MATCH_GIT_URL"),
      git_branch: "match-certs",
      readonly: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Roster.xcodeproj",
      team_id: ENV.fetch("IOS_TEAM_ID"),
      bundle_identifier: "de.thomas-peterson.roster",
      code_sign_identity: "Apple Distribution",
      profile_name: "match AppStore de.thomas-peterson.roster"
    )

    build_app(
      project: "Roster.xcodeproj",
      scheme: "Roster",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{ENV.fetch('GITHUB_RUN_NUMBER', '1')}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
